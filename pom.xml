<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jpmsilva.jsystemd</groupId>
  <artifactId>jsystemd</artifactId>
  <version>5.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>jsystemd</name>
  <description>jsystemd aims to provide a better platform to integrate Java applications with systemd, and run them as proper operating system services.
  </description>

  <inceptionYear>2017</inceptionYear>

  <url>https://jpmsilva.github.io/jsystemd-site/</url>

  <issueManagement>
    <url>https://github.com/jpmsilva/jsystemd/issues</url>
    <system>GitHub Issues</system>
  </issueManagement>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/jpmsilva/jsystemd</url>
    <connection>scm:git:https://github.com/jpmsilva/jsystemd.git</connection>
    <developerConnection>scm:git:https://github.com/jpmsilva/jsystemd.git</developerConnection>
  </scm>

  <developers>
    <developer>
      <id>jpmsilva</id>
      <name>Joao Silva</name>
      <email>joao.p.m.silva@gmail.com</email>
      <url>https://github.com/jpmsilva</url>
      <timezone>Europe/Lisbon</timezone>
    </developer>
  </developers>

  <properties>
    <!-- the time of the entries of the jars, rather than that of the build, so that builds of the same commit give the same bytes; versions:set, in
    do-release, updates it along with the version -->
    <project.build.outputTimestamp>2026-11-16T00:00:00Z</project.build.outputTimestamp>
    <!-- the minimum supported JDK: the sources are compiled and documented with its toolchain, so that the build does not depend on the JDK Maven runs on,
    except for those for Java 22 and later below -->
    <maven.compiler.release>17</maven.compiler.release>
    <!-- the Java version of the classes that jsystemd-core uses from Java 22 on, in META-INF/versions of its multi-release jar, and of their tests in
    jsystemd-core-java22-tests -->
    <java22.release>22</java22.release>
    <!-- the JDK those are compiled and tested with: the first supported JDK that has the Foreign Function and Memory API, which they use; do-full-build
    checks that it is one of the supported JDKs -->
    <java22.jdk.version>25</java22.jdk.version>
    <!-- the supported JDKs, the released LTS versions from the minimum one on: the tests run on the toolchain of each, in the surefire executions below,
    which must be kept in line with this list; do-full-build reads it to check that each toolchain is available -->
    <supported.jdk.versions>17,21,25</supported.jdk.versions>
    <!-- the JDK the nullness of the sources is checked with, in the nullaway compiler execution below, as Error Prone needs JDK 21 or later to run, while the
    sources are still compiled for the minimum supported JDK -->
    <nullaway.jdk.version>25</nullaway.jdk.version>
    <!-- the nullness is only checked in the modules that are published, which turn it on -->
    <nullaway.skip>true</nullaway.skip>

    <!-- Plugin version -->
    <plugin.clean.version>3.5.0</plugin.clean.version>
    <plugin.install.version>3.2.0</plugin.install.version>
    <plugin.resources.version>3.5.0</plugin.resources.version>
    <plugin.surefire.version>3.6.1</plugin.surefire.version>
    <plugin.failsafe.version>3.6.1</plugin.failsafe.version>
    <plugin.dependency.version>3.11.0</plugin.dependency.version>
    <plugin.compiler.version>3.16.0</plugin.compiler.version>
    <plugin.jar.version>3.5.1</plugin.jar.version>
    <plugin.shade.version>3.6.2</plugin.shade.version>
    <plugin.site.version>3.22.0</plugin.site.version>
    <plugin.github-site.version>0.12</plugin.github-site.version>
    <plugin.central-publishing.version>0.12.0</plugin.central-publishing.version>
    <plugin.deploy.version>3.2.0</plugin.deploy.version>
    <plugin.project-info-reports.version>3.9.0</plugin.project-info-reports.version>
    <plugin.versions.version>2.25.1</plugin.versions.version>
    <plugin.gpg.version>3.2.8</plugin.gpg.version>
    <plugin.source.version>3.4.0</plugin.source.version>
    <plugin.javadoc.version>3.12.0</plugin.javadoc.version>
    <plugin.checkstyle.version>3.6.0</plugin.checkstyle.version>
    <plugin.github-release.version>1.6.0</plugin.github-release.version>
    <plugin.jxr.version>3.6.0</plugin.jxr.version>
    <plugin.pmd.version>3.28.0</plugin.pmd.version>
    <plugin.enforcer.version>3.7.0</plugin.enforcer.version>
    <plugin.build-helper.version>3.6.2</plugin.build-helper.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <net.java.dev.jna.version>5.19.1</net.java.dev.jna.version>
    <org.slf4j.version>2.0.20</org.slf4j.version>
    <org.jspecify.version>1.0.1</org.jspecify.version>
    <org.junit.version>6.1.3</org.junit.version>
    <org.assertj.version>3.27.7</org.assertj.version>
    <org.mockito.version>5.24.0</org.mockito.version>
    <net.bytebuddy.version>1.18.3</net.bytebuddy.version>
    <!-- the version that the Spring Boot version below manages, as this one also applies to the Spring Boot modules, which would otherwise mix it with the
    logback-core of Spring Boot: move them together -->
    <ch.qos.logback.version>1.5.38</ch.qos.logback.version>
    <org.testcontainers.version>2.0.5</org.testcontainers.version>
    <org.awaitility.version>4.3.0</org.awaitility.version>
    <com.google.errorprone.version>2.52.0</com.google.errorprone.version>
    <com.uber.nullaway.version>0.14.3</com.uber.nullaway.version>

    <!-- only used by the Spring Boot modules, which import the Spring Boot dependency management themselves, so that jsystemd-core does not depend on it;
    Spring Boot 4.0.0 and later are supported, and the modules are built and tested against the latest 4.0.x release -->
    <org.springframework.boot.version>4.0.9</org.springframework.boot.version>
    <!-- the Spring Framework version of the Spring Boot version above, only for the links to its javadoc -->
    <org.springframework.version>7.0.10</org.springframework.version>
    <!-- the Spring Cloud release aligned with the Spring Boot version above, only used to test the starter under Spring Cloud -->
    <org.springframework.cloud.context.version>5.0.4</org.springframework.cloud.context.version>
    <!-- the latest release of Keycloak, which the Keycloak module is built against, and the integration tests run; the versions of the libraries that
         Keycloak provides, such as Quarkus, come from its own dependency management -->
    <org.keycloak.version>26.8.2</org.keycloak.version>
  </properties>

  <distributionManagement>
    <snapshotRepository>
      <id>central</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
    <site>
      <id>github-pages-sites</id>
      <name>Deployment through GitHub's site deployment plugin</name>
      <url>_versions/${project.version}</url>
    </site>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna</artifactId>
        <version>${net.java.dev.jna.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${org.slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${org.jspecify.version}</version>
      </dependency>

      <!-- test dependencies -->
      <dependency>
        <!-- all the JUnit artifacts, so that they share a version, rather than only those declared in the modules -->
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${org.junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${org.assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${org.mockito.version}</version>
      </dependency>
      <!-- Byte Buddy, which Mockito and AssertJ both depend on, in different versions: the agent that Mockito installs for its inline mocks must have the
      version of Byte Buddy itself -->
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy</artifactId>
        <version>${net.bytebuddy.version}</version>
      </dependency>
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy-agent</artifactId>
        <version>${net.bytebuddy.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${ch.qos.logback.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${org.testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${org.awaitility.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${plugin.clean.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${plugin.install.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${plugin.resources.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${plugin.surefire.version}</version>
          <configuration>
            <argLine>-XX:+EnableDynamicAgentLoading</argLine>
          </configuration>
          <executions>
            <execution>
              <!-- on the minimum supported JDK -->
              <id>default-test</id>
              <configuration>
                <jdkToolchain>
                  <version>${maven.compiler.release}</version>
                </jdkToolchain>
              </configuration>
            </execution>
            <execution>
              <id>test-jdk21</id>
              <goals>
                <goal>test</goal>
              </goals>
              <configuration>
                <jdkToolchain>
                  <version>21</version>
                </jdkToolchain>
                <reportsDirectory>${project.build.directory}/surefire-reports-jdk21</reportsDirectory>
              </configuration>
            </execution>
            <execution>
              <id>test-jdk25</id>
              <goals>
                <goal>test</goal>
              </goals>
              <configuration>
                <jdkToolchain>
                  <version>25</version>
                </jdkToolchain>
                <reportsDirectory>${project.build.directory}/surefire-reports-jdk25</reportsDirectory>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${plugin.failsafe.version}</version>
          <configuration>
            <!-- only drives the containers, so it runs on the minimum supported JDK: the library runs on the JDK of the container -->
            <jdkToolchain>
              <version>${maven.compiler.release}</version>
            </jdkToolchain>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${plugin.dependency.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${plugin.compiler.version}</version>
          <configuration>
            <jdkToolchain>
              <version>${maven.compiler.release}</version>
            </jdkToolchain>
            <showWarnings>true</showWarnings>
            <showDeprecation>true</showDeprecation>
            <compilerArgs>
              <!-- annotation processors found on the class path, such as the Spring Boot configuration processor, only run by default up to Java 22 -->
              <compilerArg>-proc:full</compilerArg>
            </compilerArgs>
          </configuration>
          <executions>
            <execution>
              <!-- checks that the sources of the @NullMarked packages respect their nullness annotations, with NullAway, failing the build otherwise; the
              classes are compiled again for that, into a directory of their own, so that the classes compiled with the minimum supported JDK are packaged -->
              <id>nullaway</id>
              <!-- before the regular compilation, which then sets the output of the module back to the classes it compiles, for the modules built
              after it in the same build, rather than leaving them these classes, without the resources -->
              <phase>process-sources</phase>
              <goals>
                <goal>compile</goal>
              </goals>
              <configuration>
                <skipMain>${nullaway.skip}</skipMain>
                <jdkToolchain>
                  <version>${nullaway.jdk.version}</version>
                </jdkToolchain>
                <outputDirectory>${project.build.directory}/nullaway-classes</outputDirectory>
                <!-- only Error Prone and NullAway run, and no other annotation processor -->
                <annotationProcessorPaths>
                  <path>
                    <groupId>com.google.errorprone</groupId>
                    <artifactId>error_prone_core</artifactId>
                    <version>${com.google.errorprone.version}</version>
                  </path>
                  <path>
                    <groupId>com.uber.nullaway</groupId>
                    <artifactId>nullaway</artifactId>
                    <version>${com.uber.nullaway.version}</version>
                  </path>
                </annotationProcessorPaths>
                <!-- appended to the arguments of the plugin -->
                <compilerArgs combine.children="append">
                  <compilerArg>-XDcompilePolicy=simple</compilerArg>
                  <compilerArg>--should-stop=ifError=FLOW</compilerArg>
                  <compilerArg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</compilerArg>
                  <!-- as the compiler of the toolchain runs in a process of its own -->
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</compilerArg>
                  <compilerArg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</compilerArg>
                </compilerArgs>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${plugin.jar.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${plugin.shade.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${plugin.site.version}</version>
          <configuration>
            <skipDeploy>true</skipDeploy>
          </configuration>
        </plugin>

        <plugin>
          <groupId>com.github.github</groupId>
          <artifactId>site-maven-plugin</artifactId>
          <version>${plugin.github-site.version}</version>
          <configuration>
            <server>github.com</server>
            <message>New site version: ${project.version}</message>
            <merge>true</merge>
            <repositoryOwner>jpmsilva</repositoryOwner>
            <repositoryName>jsystemd-site</repositoryName>
            <branch>refs/heads/master</branch>
            <includes>
              <include>**/*</include>
            </includes>
            <path>${project.distributionManagement.site.url}</path>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${plugin.central-publishing.version}</version>
          <extensions>true</extensions>
          <configuration>
            <publishingServerId>central</publishingServerId>
            <autoPublish>true</autoPublish>
            <waitUntil>published</waitUntil>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${plugin.deploy.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>${plugin.project-info-reports.version}</version>
        </plugin>

        <plugin>
          <!-- sets the versions of all the modules when releasing, in do-release -->
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${plugin.versions.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${plugin.gpg.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${plugin.source.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${plugin.javadoc.version}</version>
          <configuration>
            <jdkToolchain>
              <version>${maven.compiler.release}</version>
            </jdkToolchain>
            <!-- the plugin adds the -no-fonts option of Java 23 and later from the JDK Maven runs on, rather than from the toolchain, which may not have it;
            fonts are only bundled from Java 23 on anyway -->
            <disableNoFonts>true</disableNoFonts>
            <!-- on the class path, as the modules are compiled: the plugin otherwise documents a module with an Automatic-Module-Name as a module, with its
            dependencies on the module path, where Tomcat and the Servlet API, which both have the jakarta.servlet packages, cannot be read together -->
            <legacyMode>true</legacyMode>
            <links>
              <link>https://docs.oracle.com/en/java/javase/17/docs/api/</link>
              <link>https://java-native-access.github.io/jna/${net.java.dev.jna.version}/javadoc/</link>
            </links>
            <doctitle>${project.name} ${project.version}</doctitle>
            <windowtitle>${project.artifactId} ${project.version}</windowtitle>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${plugin.checkstyle.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>12.3.1</version>
            </dependency>
          </dependencies>
        </plugin>

        <plugin>
          <!-- run by do-release once the tag is pushed, rather than on deploy: given a tag that GitHub does not have, GitHub would create it on its default
          branch -->
          <groupId>de.jutzig</groupId>
          <artifactId>github-release-plugin</artifactId>
          <version>${plugin.github-release.version}</version>
          <configuration>
            <description>Version ${project.version}</description>
            <releaseName>${project.version}</releaseName>
            <tag>version-${project.version}</tag>
            <repositoryId>jpmsilva/jsystemd</repositoryId>
            <!-- the files that do-release stages to attach to the release: the jars of the published modules, and their SHA-256 checksums -->
            <fileSets>
              <fileSet>
                <directory>${project.build.directory}/github-release</directory>
              </fileSet>
            </fileSets>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jxr-plugin</artifactId>
          <version>${plugin.jxr.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${plugin.pmd.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${plugin.enforcer.version}</version>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${plugin.build-helper.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.github.github</groupId>
        <artifactId>site-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>site</goal>
            </goals>
            <phase>site-deploy</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- https://github.com/checkstyle/checkstyle/blob/checkstyle-13.0.0/src/main/resources/google_checks.xml with line length set to 160 -->
              <configLocation>google_checks.xml</configLocation>
              <consoleOutput>true</consoleOutput>
              <!-- the Google checks report every violation as a warning, so the build fails on warnings, rather than only on errors -->
              <violationSeverity>warning</violationSeverity>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <!-- the source cross-reference is only generated in the site of the root project, where the reports of the modules do not find it -->
          <linkXRef>false</linkXRef>
        </configuration>
        <executions>
          <execution>
            <id>validate-pmd</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
          <execution>
            <id>validate-cpd</id>
            <phase>validate</phase>
            <goals>
              <goal>cpd-check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>3.6.3</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>sample</id>
      <activation>
        <property>
          <name>!performRelease</name>
        </property>
      </activation>
      <modules>
        <module>jsystemd-spring-boot-sample</module>
      </modules>
    </profile>
    <profile>
      <!-- runs the library under a real systemd, in a container: needs Docker, or the Podman API socket, so it is only run when asked for -->
      <id>integration-tests</id>
      <modules>
        <module>jsystemd-integration-tests</module>
      </modules>
    </profile>
    <profile>
      <id>release-profile</id>
      <activation>
        <property>
          <name>performRelease</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <reportSets>
          <reportSet>
            <id>all</id>
            <reports>
              <report>index</report>
              <report>dependencies</report>
              <report>licenses</report>
            </reports>
          </reportSet>
          <reportSet>
            <id>top</id>
            <inherited>false</inherited>
            <reports>
              <report>index</report>
              <report>team</report>
              <report>issue-management</report>
              <report>licenses</report>
              <report>scm</report>
              <report>distribution-management</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <reportSets>
          <reportSet>
            <id>default</id>
            <!-- overwrite the default javadoc set inherited to all child modules, to not generate multiple apidocs folders -->
            <reports>
            </reports>
          </reportSet>
          <reportSet>
            <id>aggregate</id>
            <inherited>false</inherited>
            <configuration>
              <!-- the aggregated javadoc also covers the Spring Boot modules; not inherited, so jsystemd-core does not link to Spring -->
              <links combine.children="append">
                <link>https://docs.spring.io/spring-boot/api/java/</link>
                <link>https://docs.spring.io/spring-framework/docs/${org.springframework.version}/javadoc-api/</link>
              </links>
            </configuration>
            <reports>
              <report>aggregate</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <failsOnError>true</failsOnError>
          <!-- https://github.com/checkstyle/checkstyle/blob/checkstyle-13.0.0/src/main/resources/google_checks.xml with line length set to 160 -->
          <configLocation>google_checks.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <!-- the source cross-reference is only generated in the site of the root project, where the reports of the modules do not find it -->
          <linkXRef>false</linkXRef>
        </configuration>
        <reportSets>
          <reportSet>
            <reports>
              <report>checkstyle</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
        <inherited>false</inherited>
        <reportSets>
          <reportSet>
            <id>aggregate</id>
            <inherited>false</inherited>
            <reports>
              <report>aggregate</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <!-- the source cross-reference is only generated in the site of the root project, where the reports of the modules do not find it -->
          <linkXRef>false</linkXRef>
        </configuration>
        <reportSets>
          <reportSet>
            <reports>
              <report>pmd</report>
              <report>cpd</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>

  <modules>
    <module>jsystemd-core</module>
    <!-- not published: tests the classes of jsystemd-core for Java 22 and later, on its multi-release jar -->
    <module>jsystemd-core-java22-tests</module>
    <module>jsystemd-spring-boot</module>
    <module>jsystemd-spring-boot-starter</module>
    <module>jsystemd-keycloak</module>
  </modules>
</project>
