<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jsystemd-integration-tests</artifactId>

  <parent>
    <groupId>com.github.jpmsilva.jsystemd</groupId>
    <artifactId>jsystemd</artifactId>
    <version>5.1.0</version>
  </parent>

  <name>jsystemd integration tests</name>
  <description>
    Tests the library under a real systemd, running in a container. The main code is the fixture application that the tests run as a systemd service,
    along with the Spring Boot sample application, and Keycloak with the Keycloak provider.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.github.jpmsilva.jsystemd</groupId>
      <artifactId>jsystemd-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- only copied into the container image, as an executable jar: on the test classpath, it would only add its launcher classes -->
      <groupId>com.github.jpmsilva.jsystemd</groupId>
      <artifactId>jsystemd-spring-boot-sample</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- only copied into the providers directory of Keycloak, in the container image -->
      <groupId>com.github.jpmsilva.jsystemd</groupId>
      <artifactId>jsystemd-keycloak</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- the runtime dependencies of the fixture application, copied into the container image along with its classes -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-fixture-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/fixture-lib</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>copy-sample</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.github.jpmsilva.jsystemd</groupId>
                  <artifactId>jsystemd-spring-boot-sample</artifactId>
                  <version>${project.version}</version>
                  <destFileName>sample.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jpmsilva.jsystemd</groupId>
                  <artifactId>jsystemd-keycloak</artifactId>
                  <version>${project.version}</version>
                  <destFileName>keycloak-provider.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/fixture-sample</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <!-- the distribution of Keycloak, unpacked into keycloak-${org.keycloak.version}; it is only unpacked again when its version changes -->
            <id>unpack-keycloak</id>
            <phase>package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.keycloak</groupId>
                  <artifactId>keycloak-quarkus-dist</artifactId>
                  <version>${org.keycloak.version}</version>
                  <type>zip</type>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/fixture-keycloak</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <!-- the tests run once for each JDK the applications run on in the containers: on Java 21, the notifications go through JNA and libsystemd,
          and on Java 25, through the Foreign Function and Memory API; each run has its own reports, and its own summary, which its verify goal checks -->
          <execution>
            <id>it-jdk21</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <systemPropertyVariables combine.children="append">
                <fixture.jdk>21</fixture.jdk>
              </systemPropertyVariables>
              <reportsDirectory>${project.build.directory}/failsafe-reports-jdk21</reportsDirectory>
              <summaryFile>${project.build.directory}/failsafe-reports-jdk21/failsafe-summary.xml</summaryFile>
            </configuration>
          </execution>
          <execution>
            <id>it-jdk25</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <systemPropertyVariables combine.children="append">
                <fixture.jdk>25</fixture.jdk>
              </systemPropertyVariables>
              <reportsDirectory>${project.build.directory}/failsafe-reports-jdk25</reportsDirectory>
              <summaryFile>${project.build.directory}/failsafe-reports-jdk25/failsafe-summary.xml</summaryFile>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <fixture.docker>${project.basedir}/src/test/docker</fixture.docker>
            <fixture.classes>${project.build.outputDirectory}</fixture.classes>
            <fixture.lib>${project.build.directory}/fixture-lib</fixture.lib>
            <fixture.sample>${project.build.directory}/fixture-sample/sample.jar</fixture.sample>
            <fixture.keycloak>${project.build.directory}/fixture-keycloak/keycloak-${org.keycloak.version}</fixture.keycloak>
            <fixture.keycloak-provider>${project.build.directory}/fixture-sample/keycloak-provider.jar</fixture.keycloak-provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <configuration>
          <skipSource>true</skipSource>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
