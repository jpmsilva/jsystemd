#!/bin/bash

# Publishes the site of the version of the project: builds it with do-site-build, and has the site-deploy profile commit it to the repository that
# GitHub Pages serves it from, in the directory of the version, and push it, with git.
#
# Usage: do-site-release [--dry-run]
#
# With --dry-run, builds the site the same, but only lists the files that publishing it would add, update and delete in that repository, without
# committing or pushing anything.

SCRIPT=$(readlink -f "$0")
SCRIPTPATH=$(dirname "$SCRIPT")

set -e

DRY_RUN=false
if [ "$1" = "--dry-run" ]; then
  DRY_RUN=true
fi

cd "${SCRIPTPATH}"

# the site is committed in a fresh clone of that repository, which does not see the identity set in this one's config, so it is passed to git
# through the environment
GIT_NAME=$(git config user.name || true)
GIT_EMAIL=$(git config user.email || true)
if [ -z "${GIT_NAME}" ] || [ -z "${GIT_EMAIL}" ]; then
  echo "No git identity to commit the site with: set user.name and user.email, in this repository or globally." >&2
  exit 1
fi
export GIT_AUTHOR_NAME="${GIT_NAME}" GIT_AUTHOR_EMAIL="${GIT_EMAIL}" GIT_COMMITTER_NAME="${GIT_NAME}" GIT_COMMITTER_EMAIL="${GIT_EMAIL}"

./do-site-build

# published once, as a whole, from the root project
./mvnw -N scm-publish:publish-scm -Dscmpublish.dryRun=${DRY_RUN} -P site-deploy
